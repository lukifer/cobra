.col-md-6
  - if @overview_notices
    - @overview_notices.each do |notice|
      .alert.alert-info #{notice}
  .card
    / pre.mb-0.small= JSON.pretty_generate(@players.as_json)
    pre.mb-0.small= JSON.pretty_generate(@tournament.corp_faction_counts.as_json)
    ul.list-group.list-group-flush
      / - corp_counts = @tournament.corp_faction_counts
      / - runner_counts = @tournament.runner_faction_counts
      li.list-group-item
        | HB: #{@tournament.corp_faction_counts.fetch("haas-bioroid", 0)}
        | Jinteki: #{@tournament.corp_faction_counts.fetch("jinteki", 0)}
        | NBN: #{@tournament.corp_faction_counts.fetch("nbn", 0)}
        | Weyland: #{@tournament.corp_faction_counts.fetch("weyland-consortium", 0)}
        | Other: #{@tournament.corp_faction_counts.fetch("neutral-corp", 0)}

        | Adam: #{@tournament.runner_faction_counts.fetch("adam", 0)}
        | Apex: #{@tournament.runner_faction_counts.fetch("apex", 0)}
        | Sunny: #{@tournament.runner_faction_counts.fetch("sunny-lebeau", 0)}
        | Anarch: #{@tournament.runner_faction_counts.fetch("anarch", 0)}
        | Criminal: #{@tournament.runner_faction_counts.fetch("criminal", 0)}
        | Shaper: #{@tournament.runner_faction_counts.fetch("shaper", 0)}
        | Other: #{@tournament.runner_faction_counts.fetch("neutral-runner", 0)}
      - if @tournament.slug
        li.list-group-item
          .small.text-secondary Shortcode:
          | #{@tournament.slug} (
          = link_to tournament_url(@tournament.slug, request), tournament_url(@tournament.slug, request)
          | )

      li.list-group-item
        .small.text-secondary Date:
        | #{@tournament.date.strftime('%A, %B %e, %Y')}
        - if @tournament.registration_starts && @tournament.tournament_starts
          .small.text-secondary Registration & First Round Times:
          | #{@tournament.registration_starts} / #{@tournament.tournament_starts} #{@tournament.time_zone.nil? ? '' : " (#{@tournament.time_zone})"}
        - elsif @tournament.registration_starts
          .small.text-secondary Registration:
          | #{@tournament.registration_starts} #{@tournament.time_zone.nil? ? '' : " (#{@tournament.time_zone})"}
        - elsif @tournament.tournament_starts
          .small.text-secondary First Round:
          | #{@tournament.tournament_starts} #{@tournament.time_zone.nil? ? '' : " (#{@tournament.time_zone})"}

      li.list-group-item
        .small.text-secondary Organiser:
        | #{@tournament.user.nrdb_username} #{@tournament.organizer_contact.nil? ? '' : " – #{@tournament.organizer_contact}"}
      li.list-group-item
        .small.text-secondary Players:
        => pluralize(@players.count, 'active player')
        | (#{@dropped.count} dropped)
      li.list-group-item
        .small.text-secondary
          | QR Code:
        .row
          .col-sm-6
            = link_to qr_tournament_path(@tournament), :target => '_blank' do
              => fa_icon 'qrcode'
              | Open Printable QR Code